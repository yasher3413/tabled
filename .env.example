# Optional. Set one of these to generate plain-English summaries; without either the site works and shows
# "summary coming soon". A valid Anthropic key is used first, then OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: force a provider (anthropic or openai).
SUMMARY_PROVIDER=
# Optional: model override for the chosen provider. Defaults: claude-haiku-4-5 (Anthropic), gpt-5.4-mini (OpenAI).
SUMMARY_MODEL=
