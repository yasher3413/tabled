# Optional. Set one of these to generate plain-English summaries; without either the site works and shows
# "summary coming soon". A valid Anthropic key is used first, then OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: force a provider (anthropic or openai).
SUMMARY_PROVIDER=
# Optional: model override for the chosen provider. Defaults: claude-haiku-4-5 (Anthropic), gpt-5.4-mini (OpenAI).
SUMMARY_MODEL=

# Report form (/report). Without GITHUB_ISSUES_TOKEN the form offers a prefilled GitHub issue link instead.
# A fine-grained PAT limited to Issues: read and write on yasher3413/tabled. Set it in Vercel (production only),
# never in a committed file.
GITHUB_ISSUES_TOKEN=
# Vercel Blob read-write token for report screenshots. Created by `vercel blob create-store`; without it,
# reports are filed without the screenshot.
BLOB_READ_WRITE_TOKEN=
# Local testing only: set to 1 to validate and format reports without filing them. Ignored on Vercel.
REPORT_FIXTURES=
