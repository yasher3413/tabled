  "components": [
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "filter-field",
      "description": "Labelled filter search field on raised paper; border firms on hover, green outline on focus.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-q\">Find an MP</label><div class=\"ds-field-wrap\"><span class=\"ds-field-icon\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg></span><input id=\"ds-q\" class=\"ds-input\" type=\"search\" placeholder=\"Name, riding or province\"></div></div>",
      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-field{display:flex;flex-direction:column;gap:4px;font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;max-width:22rem} .ds-field-label{font-size:0.75rem;font-weight:500;color:var(--ink-3)} .ds-field-wrap{position:relative} .ds-field-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--ink-3);display:flex} .ds-input{height:40px;width:100%;padding:0 36px;border:1px solid var(--rule);border-radius:0.1125rem;background:var(--paper-raised);color:var(--ink);font:inherit;font-size:0.9375rem;transition:border-color 150ms cubic-bezier(0.25,1,0.5,1)} .ds-input::placeholder{color:var(--ink-3)} .ds-input:hover{border-color:var(--ink-3)} .ds-input:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px}"
    },
    {
      "name": "Postal Code Form",
      "kind": "button",
      "refersTo": "submit-ink",
      "description": "The one solid button: ink submit attached to a 48px postal field, turning Commons Green on hover.",
      "html": "<form class=\"ds-postal\" onsubmit=\"return false\"><input class=\"ds-postal-input\" placeholder=\"Postal code, like K1A 0A6\" aria-label=\"Postal code\"><button class=\"ds-postal-btn\" type=\"submit\">Find your MP</button></form>",
      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-postal{display:flex;height:48px;max-width:26rem;border:1px solid color-mix(in oklch,var(--rule-strong) 70%,transparent);border-radius:0.1125rem;overflow:hidden;background:var(--paper-raised);font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;transition:border-color 150ms} .ds-postal:hover,.ds-postal:focus-within{border-color:var(--ink)} .ds-postal-input{flex:1;min-width:0;border:0;background:transparent;padding:0 12px;font:inherit;font-size:1rem;color:var(--ink);text-transform:uppercase;outline:none} .ds-postal-input::placeholder{text-transform:none;color:var(--ink-3)} .ds-postal-btn{border:0;background:var(--ink);color:var(--paper);padding:0 16px;font:inherit;font-size:0.9375rem;font-weight:500;cursor:pointer;transition:background 150ms cubic-bezier(0.25,1,0.5,1)} .ds-postal-btn:hover{background:var(--accent-ink)} .ds-postal-btn:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px}"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Serif wordmark, sans links in ink-2; the active link takes a 2px Commons Green rule on the header's hairline.",
      "html": "<header class=\"ds-nav\"><span class=\"ds-wordmark\">Tabled</span><a class=\"ds-navlink\" href=\"#\">Bills</a><a class=\"ds-navlink\" aria-current=\"page\" href=\"#\">Votes</a><a class=\"ds-navlink\" href=\"#\">MPs</a><a class=\"ds-navlink\" href=\"#\">Parties</a></header>",
      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-nav{display:flex;align-items:center;gap:4px;height:60px;padding:0 24px;border-bottom:1px solid var(--rule);background:var(--paper);font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;} .ds-wordmark{font-family:'Brygada 1918',ui-serif,Georgia,serif;font-size:1.375rem;font-weight:600;letter-spacing:-0.01em;margin-right:16px;color:var(--ink)} .ds-navlink{position:relative;display:inline-flex;align-items:center;height:36px;padding:0 10px;font-size:0.9375rem;color:var(--ink-2);text-decoration:none;transition:color 150ms} .ds-navlink:hover{color:var(--ink)} .ds-navlink[aria-current=page]{color:var(--ink)} .ds-navlink[aria-current=page]::after{content:'';position:absolute;left:10px;right:10px;bottom:-12px;height:2px;background:var(--accent-ink)} .ds-navlink:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px}"
