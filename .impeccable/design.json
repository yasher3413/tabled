      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-ledger{margin:0;max-width:26rem;font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;} .ds-ledger div{display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:12px 0;border-bottom:1px solid var(--rule)} .ds-ledger dt{font-size:0.9375rem;color:var(--ink)} .ds-ledger small{display:block;font-size:0.8125rem;color:var(--ink-3)} .ds-ledger .sc{font-variant-caps:small-caps;letter-spacing:0.02em} .ds-ledger dd{margin:0;font-family:'Brygada 1918',ui-serif,Georgia,serif;font-size:1.625rem;line-height:1;font-weight:600;letter-spacing:-0.01em;color:var(--ink);font-variant-numeric:tabular-nums}"
