      "refersTo": "tally-bar-yea",
      "description": "Result and figures above a neutral ink and sepia split bar with a halfway hairline.",
      "html": "<div class=\"ds-tally\"><div class=\"ds-tally-top\"><b>Passed</b><span><b>296</b> yea <i>to</i> <b>26</b> nay<i> · 10 paired</i></span></div><div class=\"ds-bar\"><span class=\"ds-yea\" style=\"width:91.9%\"></span><span class=\"ds-nay\"></span><span class=\"ds-mid\"></span></div></div>",
      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-tally{max-width:17rem;font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;font-size:0.8125rem;color:var(--ink-2);font-variant-numeric:tabular-nums} .ds-tally-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px} .ds-tally b{color:var(--ink);font-weight:600} .ds-tally i{font-style:normal;color:var(--ink-3)} .ds-bar{position:relative;display:flex;height:8px;margin-top:6px;border-radius:1px;overflow:hidden;background:var(--paper-sunk)} .ds-yea{background:var(--ballot-yea)} .ds-nay{flex:1;background:var(--ballot-nay)} .ds-mid{position:absolute;top:-2px;bottom:-2px;left:50%;width:1px;background:var(--paper)}"
    },
    {
      "name": "Party Breakdown Table",
      "kind": "custom",
      "refersTo": "",
      "description": "Ruled division table, parties by seats, totals in the serif under a 3px double rule.",
      "html": "<table class=\"ds-tbl\"><thead><tr><th>Party</th><th>Position</th><th class=\"r\">Yea</th><th class=\"r\">Nay</th></tr></thead><tbody><tr><th><span class=\"ds-sw\" style=\"background:var(--party-liberal)\"></span>Liberal</th><td>Yea</td><td class=\"r\">167</td><td class=\"r\">0</td></tr><tr><th><span class=\"ds-sw\" style=\"background:var(--party-conservative)\"></span>Conservative</th><td>Yea</td><td class=\"r\">129</td><td class=\"r\">0</td></tr><tr><th><span class=\"ds-sw\" style=\"background:var(--party-bloc)\"></span>Bloc</th><td>Nay <i>1 broke ranks</i></td><td class=\"r\">1</td><td class=\"r\">19</td></tr></tbody><tfoot><tr><th>Total</th><td></td><td class=\"r\">297</td><td class=\"r\">19</td></tr></tfoot></table>",
      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-tbl{width:100%;max-width:32rem;border-collapse:collapse;font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;font-size:0.875rem;color:var(--ink);font-variant-numeric:tabular-nums lining-nums} .ds-tbl th,.ds-tbl td{padding:8px 12px 8px 0;text-align:left;font-weight:400} .ds-tbl thead th{font-size:0.75rem;font-weight:500;color:var(--ink-3);border-bottom:1px solid var(--rule)} .ds-tbl tbody tr{border-bottom:1px solid var(--rule)} .ds-tbl tbody tr:last-child{border-bottom:0} .ds-tbl .r{text-align:right} .ds-tbl i{font-style:normal;font-size:0.8125rem;color:var(--ink-3);margin-left:8px} .ds-sw{display:inline-block;width:10px;height:10px;border-radius:1px;margin-right:8px} .ds-tbl tfoot th,.ds-tbl tfoot td{border-top:3px double var(--rule-strong);padding-top:8px} .ds-tbl tfoot th{font-size:0.8125rem;font-weight:600} .ds-tbl tfoot td{font-family:'Brygada 1918',ui-serif,Georgia,serif;font-size:1.75rem;line-height:1;font-weight:600}"
    },
    {
      "name": "Readings Ledger",
      "kind": "custom",
      "refersTo": "",
      "description": "Stage timeline drawn by form: filled node and solid rule done, folded green flag current, hollow node and dashed rule ahead.",
      "html": "<ol class=\"ds-tl\"><li class=\"done\"><span class=\"n\"></span><b>First reading</b><small>Sep 21</small></li><li class=\"done\"><span class=\"n\"></span><b>Second reading</b><small>Oct 8</small></li><li class=\"cur\"><span class=\"n\"><svg class=\"ds-flag\" viewBox=\"0 0 16 18\" aria-hidden=\"true\"><path d=\"M3 17V1.5\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"/><path d=\"M3.9 2h9.6l-2.6 3.6 2.6 3.6H3.9z\" fill=\"currentColor\"/><path d=\"M3.9 9.2l2.4 1.9V9.2z\" fill=\"currentColor\" opacity=\"0.55\"/></svg></span><b>Committee</b><small class=\"now\">Now here</small></li><li class=\"todo\"><span class=\"n\"></span><b>Report stage</b><small></small></li><li class=\"todo last\"><span class=\"n\"></span><b>Third reading</b><small></small></li></ol>",
      "css": ":host{--paper:oklch(0.976 0.011 84);--paper-sunk:oklch(0.951 0.014 82);--paper-raised:oklch(0.992 0.006 84);--ink:oklch(0.215 0.014 62);--ink-2:oklch(0.4 0.014 62);--ink-3:oklch(0.49 0.014 62);--rule:oklch(0.86 0.014 78);--rule-strong:oklch(0.3 0.014 62);--accent-ink:oklch(0.43 0.085 166);--accent-wash:oklch(0.935 0.028 166);--ballot-yea:oklch(0.3 0.014 62);--ballot-nay:oklch(0.67 0.05 62);--party-liberal:oklch(0.56 0.18 25);--party-conservative:oklch(0.47 0.12 255);--party-bloc:oklch(0.68 0.1 228);--party-ndp:oklch(0.7 0.15 58);--party-green:oklch(0.6 0.14 140);} .ds-tl{display:flex;list-style:none;margin:0;padding:0;font-family:'Libre Franklin',ui-sans-serif,system-ui,sans-serif;} .ds-tl li{position:relative;flex:1;display:flex;flex-direction:column;gap:6px;padding-right:8px} .ds-tl li::before{content:'';position:absolute;top:7px;left:16px;width:100%;border-top:2px dashed var(--rule)} .ds-tl li.done::before{border-top-style:solid;border-color:var(--ink)} .ds-tl li.last::before{display:none} .ds-tl .n{position:relative;z-index:1;width:16px;height:16px;display:flex;align-items:center;justify-content:center;background:var(--paper)} .ds-tl .done .n::after{content:'';width:12px;height:12px;border-radius:50%;background:var(--ink)} .ds-tl .todo .n::after{content:'';width:12px;height:12px;box-sizing:border-box;border-radius:50%;border:2px solid color-mix(in oklch,var(--ink-3) 45%,transparent)} .ds-flag{width:18px;height:18px;transform:translateY(-3px);color:var(--accent-ink)} .ds-tl b{font-size:0.9375rem;font-weight:500;color:var(--ink)} .ds-tl .todo b{font-weight:400;color:var(--ink-3)} .ds-tl small{font-size:0.8125rem;color:var(--ink-3)} .ds-tl small.now{color:var(--accent-ink);font-weight:500}"
    },
    {
      "name": "Ledger Row",
      "kind": "custom",
      "refersTo": "",
